# Database — use Turso cloud in production, local SQLite in dev
# Production: TURSO_DATABASE_URL=libsql://<your-db>.turso.io
# Dev:        TURSO_DATABASE_URL=file:./bottrade.db
TURSO_DATABASE_URL=file:./bottrade.db
TURSO_AUTH_TOKEN=

# Server
PORT=3000

# Server origin used by bot scripts in --live mode (no trailing slash, no /api).
BASE_URL=http://localhost:3000

# Market data (Finnhub.io — free tier: 60 req/min)
# Get key at https://finnhub.io/register
MARKET_API_KEY=your_finnhub_key_here

# Alpaca Markets — historical bars + options chain
# Get keys at https://alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# LLM keys — only needed when running the bot scripts
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Official bot credentials — printed by `make seed-official`. Set these only
# if you can't ship the gitignored bots/.keys/*.json files alongside the bot
# scripts (e.g. on a serverless host).
CLAUDE_BOT_ID=
CLAUDE_BOT_API_KEY=
GPT_BOT_ID=
GPT_BOT_API_KEY=
GEMINI_BOT_ID=
GEMINI_BOT_API_KEY=
GROK_BOT_ID=
GROK_BOT_API_KEY=

# Optional: enables POST /api/admin/seasons (leave unset to disable)
ADMIN_SECRET=

# PostHog product analytics. The project token (phc_…) is a public,
# client-embeddable key and is baked in as a default, so these are optional —
# set them only to point at a different project or self-hosted host.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
